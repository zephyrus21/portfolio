---
import Layout from '../layouts/Layout.astro';
import PageChrome from '../components/PageChrome.astro';
import Footer from '../components/Footer.astro';
import { getGalleryPhotos } from '../lib/notion';

const photos = await getGalleryPhotos();
---

<Layout title="Gallery — Piyush Pandey">
  <PageChrome active="gallery" />

  <main class="page-main">
    <section class="page-hero">
      <div class="eyebrow reveal"><span class="num">02</span><span class="bar"></span><span>Gallery</span></div>
      <h1 class="h-display reveal" style="margin-top: 28px;">
        Through the <em>lens</em>.
      </h1>
      <p class="page-hero-sub reveal">
        A collection of photographs — film, street, and everything in between.
      </p>
    </section>

    <section class="gallery-section">
      <div class="gallery-grid">
        {photos.map((photo, i) => (
          <div class={`gallery-item gallery-item--${photo.aspect} reveal`} style={`--gd: ${i * 60}ms`}>
            <div class="gallery-img">
              {photo.imageUrl
                ? <img src={photo.imageUrl} alt={photo.label} loading="lazy" decoding="async" />
                : <div class="gallery-placeholder"><span class="gallery-id">{String(photo.order).padStart(2, '0')}</span></div>
              }
              <div class="gallery-overlay">
                <span class="gallery-label">{photo.label}</span>
                <span class="gallery-arrow">↗</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-main {
    padding-top: 80px;
  }

  .page-hero {
    padding: var(--pad-y) var(--gutter);
    border-top: 0;
    max-width: 900px;
  }

  .page-hero-sub {
    margin-top: 28px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .gallery-section {
    padding: 0 var(--gutter) var(--pad-y);
    border-top: 1px solid var(--rule);
    padding-top: 56px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .gallery-item {
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }

  .gallery-item--tall   { grid-column: span 1; }
  .gallery-item--wide   { grid-column: span 2; }
  .gallery-item--square { grid-column: span 1; }
  .gallery-item--portrait  { grid-column: span 1; }
  .gallery-item--landscape { grid-column: span 1; }

  .gallery-img {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .gallery-item--tall .gallery-img     { aspect-ratio: 9 / 16; }
  .gallery-item--wide .gallery-img     { aspect-ratio: 16 / 9; }
  .gallery-item--square .gallery-img   { aspect-ratio: 1 / 1; }
  .gallery-item--portrait .gallery-img  { aspect-ratio: 3 / 4; }
  .gallery-item--landscape .gallery-img { aspect-ratio: 4 / 3; }

  .gallery-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(.2, .7, .2, 1);
  }

  .gallery-item:hover .gallery-img img {
    transform: scale(1.04);
  }

  .gallery-placeholder {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(20, 17, 13, 0.055) 0 1px,
        transparent 1px 18px
      ),
      linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 700ms cubic-bezier(.2, .7, .2, 1);
  }

  .gallery-item:hover .gallery-placeholder {
    transform: scale(1.04);
  }

  .gallery-id {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0.4;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    padding: 20px 24px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    background: linear-gradient(to top, rgba(20,17,13,0.32) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 400ms ease;
  }

  body.theme-dark .gallery-overlay,
  body.theme-catppuccin .gallery-overlay,
  body.theme-nord .gallery-overlay,
  body.theme-gruvbox .gallery-overlay,
  body.theme-rose-pine .gallery-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%);
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .gallery-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }

  .gallery-arrow {
    font-family: var(--mono);
    font-size: 14px;
    color: #fff;
    transform: translate(-4px, 4px);
    transition: transform 400ms cubic-bezier(.2, .7, .2, 1);
  }

  .gallery-item:hover .gallery-arrow {
    transform: translate(0, 0);
  }

  @media (max-width: 800px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-item--wide { grid-column: span 2; }
  }

  @media (max-width: 500px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .gallery-item--wide { grid-column: span 1; }
  }
</style>
