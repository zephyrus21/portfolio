---
interface Props {
  active?: 'blog' | 'gallery';
}
const { active } = Astro.props;
---

<header class="chrome">
  <a class="mark" href="/">
    <span class="dot"></span><span class="mark-text" data-scramble>PIYUSH PANDEY · SWE · IDX/21</span>
  </a>
  <nav>
    <a href="/" data-magnetic data-nav>
      <span class="nav-num">↩</span><span class="nav-label" data-text="Home">Home</span>
    </a>
    <a href="/blog" data-magnetic data-nav class={active === 'blog' ? 'nav-active' : ''}>
      <span class="nav-num">01</span><span class="nav-label" data-text="Blog">Blog</span>
    </a>
    <a href="/gallery" data-magnetic data-nav class={active === 'gallery' ? 'nav-active' : ''}>
      <span class="nav-num">02</span><span class="nav-label" data-text="Gallery">Gallery</span>
    </a>
  </nav>
  <div class="chrome-right">
    <div class="theme-picker" id="themePicker">
      <button class="tp-trigger" id="themePickerBtn" aria-haspopup="listbox" aria-expanded="false" aria-label="Choose theme">
        <span class="tp-dot" id="tpActiveDot" style="--tw:#f3efe7"></span>
        <span class="tp-name" id="tpActiveName">Warm</span>
        <svg class="tp-caret" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
          <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="tp-panel" id="themePanel" role="listbox" aria-label="Theme" aria-hidden="true">
        <div class="tp-panel-inner">
          <div class="tp-section-label">Light</div>
          <button class="tp-option active" role="option" data-theme="warm"       data-name="Warm"       data-color="#f3efe7" aria-selected="true" ><span class="tp-dot" style="--tw:#f3efe7"></span>Warm</button>
          <button class="tp-option"        role="option" data-theme="cool"       data-name="Cool"       data-color="#eef0f2" aria-selected="false"><span class="tp-dot" style="--tw:#eef0f2"></span>Cool</button>
          <button class="tp-option"        role="option" data-theme="latte"      data-name="Latte"      data-color="#eff1f5" aria-selected="false"><span class="tp-dot" style="--tw:#eff1f5"></span>Latte</button>
          <button class="tp-option"        role="option" data-theme="parchment"  data-name="Parchment"  data-color="#f5f0e8" aria-selected="false"><span class="tp-dot" style="--tw:#f5f0e8"></span>Parchment</button>
          <button class="tp-option"        role="option" data-theme="forest"     data-name="Forest"     data-color="#f0f4ee" aria-selected="false"><span class="tp-dot" style="--tw:#f0f4ee"></span>Forest</button>
          <button class="tp-option"        role="option" data-theme="lavender"   data-name="Lavender"   data-color="#f4f0fa" aria-selected="false"><span class="tp-dot" style="--tw:#f4f0fa"></span>Lavender</button>
          <div class="tp-divider"></div>
          <div class="tp-section-label">Dark</div>
          <button class="tp-option"        role="option" data-theme="dark"       data-name="Ink"        data-color="#0d0c0b" aria-selected="false"><span class="tp-dot" style="--tw:#0d0c0b"></span>Ink</button>
          <button class="tp-option"        role="option" data-theme="catppuccin" data-name="Catppuccin" data-color="#1e1e2e" aria-selected="false"><span class="tp-dot" style="--tw:#1e1e2e"></span>Catppuccin</button>
          <button class="tp-option"        role="option" data-theme="nord"       data-name="Nord"       data-color="#2e3440" aria-selected="false"><span class="tp-dot" style="--tw:#2e3440"></span>Nord</button>
          <button class="tp-option"        role="option" data-theme="gruvbox"    data-name="Gruvbox"    data-color="#282828" aria-selected="false"><span class="tp-dot" style="--tw:#282828"></span>Gruvbox</button>
          <button class="tp-option"        role="option" data-theme="rose-pine"  data-name="Rosé Pine"  data-color="#191724" aria-selected="false"><span class="tp-dot" style="--tw:#191724"></span>Rosé Pine</button>
          <button class="tp-option"        role="option" data-theme="dracula"    data-name="Dracula"    data-color="#282a36" aria-selected="false"><span class="tp-dot" style="--tw:#282a36"></span>Dracula</button>
          <button class="tp-option"        role="option" data-theme="monokai"    data-name="Monokai"    data-color="#272822" aria-selected="false"><span class="tp-dot" style="--tw:#272822"></span>Monokai</button>
          <button class="tp-option"        role="option" data-theme="tokyo"      data-name="Tokyo Night" data-color="#1a1b26" aria-selected="false"><span class="tp-dot" style="--tw:#1a1b26"></span>Tokyo Night</button>
          <button class="tp-option"        role="option" data-theme="solarized"  data-name="Solarized"  data-color="#002b36" aria-selected="false"><span class="tp-dot" style="--tw:#002b36"></span>Solarized</button>
        </div>
      </div>
    </div>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<div class="tp-backdrop" id="themeBackdrop" aria-hidden="true"></div>

<div class="tp-fab" id="tpFab">
  <button class="tp-fab-btn" id="tpFabBtn" aria-label="Choose theme" aria-expanded="false">
    <span class="tp-fab-icon" aria-hidden="true">
      <span style="background:#f3efe7"></span>
      <span style="background:#0d0c0b"></span>
      <span style="background:#eef0f2"></span>
      <span style="background:#1e1e2e"></span>
    </span>
  </button>
  <div class="tp-fab-panel" id="tpFabPanel" aria-hidden="true">
    <button class="tp-fab-opt active" data-theme="warm"       data-name="Warm"       data-color="#f3efe7" aria-label="Warm"        style="--tw:#f3efe7"></button>
    <button class="tp-fab-opt"        data-theme="cool"       data-name="Cool"       data-color="#eef0f2" aria-label="Cool"        style="--tw:#eef0f2"></button>
    <button class="tp-fab-opt"        data-theme="latte"      data-name="Latte"      data-color="#eff1f5" aria-label="Latte"       style="--tw:#eff1f5"></button>
    <button class="tp-fab-opt"        data-theme="parchment"  data-name="Parchment"  data-color="#f5f0e8" aria-label="Parchment"   style="--tw:#f5f0e8"></button>
    <button class="tp-fab-opt"        data-theme="forest"     data-name="Forest"     data-color="#f0f4ee" aria-label="Forest"      style="--tw:#f0f4ee"></button>
    <button class="tp-fab-opt"        data-theme="lavender"   data-name="Lavender"   data-color="#f4f0fa" aria-label="Lavender"    style="--tw:#f4f0fa"></button>
    <button class="tp-fab-opt"        data-theme="dark"       data-name="Ink"        data-color="#0d0c0b" aria-label="Ink"         style="--tw:#0d0c0b"></button>
    <button class="tp-fab-opt"        data-theme="catppuccin" data-name="Catppuccin" data-color="#1e1e2e" aria-label="Catppuccin"  style="--tw:#1e1e2e"></button>
    <button class="tp-fab-opt"        data-theme="nord"       data-name="Nord"       data-color="#2e3440" aria-label="Nord"        style="--tw:#2e3440"></button>
    <button class="tp-fab-opt"        data-theme="gruvbox"    data-name="Gruvbox"    data-color="#282828" aria-label="Gruvbox"     style="--tw:#282828"></button>
    <button class="tp-fab-opt"        data-theme="rose-pine"  data-name="Rosé Pine"  data-color="#191724" aria-label="Rosé Pine"   style="--tw:#191724"></button>
    <button class="tp-fab-opt"        data-theme="dracula"    data-name="Dracula"    data-color="#282a36" aria-label="Dracula"     style="--tw:#282a36"></button>
    <button class="tp-fab-opt"        data-theme="monokai"    data-name="Monokai"    data-color="#272822" aria-label="Monokai"     style="--tw:#272822"></button>
    <button class="tp-fab-opt"        data-theme="tokyo"      data-name="Tokyo Night" data-color="#1a1b26" aria-label="Tokyo Night" style="--tw:#1a1b26"></button>
    <button class="tp-fab-opt"        data-theme="solarized"  data-name="Solarized"  data-color="#002b36" aria-label="Solarized"   style="--tw:#002b36"></button>
  </div>
</div>

<nav class="mobile-nav" id="mobileNav" aria-hidden="true">
  <a href="/" style="--nd:60ms"><span class="mn-num">↩</span>Home</a>
  <a href="/blog" style="--nd:120ms"><span class="mn-num">01</span>Blog</a>
  <a href="/gallery" style="--nd:180ms"><span class="mn-num">02</span>Gallery</a>
</nav>

<script is:inline>
  (function () {
    var picker    = document.getElementById('themePicker');
    var btn       = document.getElementById('themePickerBtn');
    var panel     = document.getElementById('themePanel');
    var backdrop  = document.getElementById('themeBackdrop');
    var dotEl     = document.getElementById('tpActiveDot');
    var nameEl    = document.getElementById('tpActiveName');
    var fab       = document.getElementById('tpFab');
    var fabBtn    = document.getElementById('tpFabBtn');
    var fabPanel  = document.getElementById('tpFabPanel');

    function applyTheme(theme, name, color) {
      if (dotEl)  dotEl.style.setProperty('--tw', color);
      if (nameEl) nameEl.textContent = name;
      if (panel) panel.querySelectorAll('.tp-option').forEach(function (o) {
        o.classList.toggle('active', o.dataset.theme === theme);
        o.setAttribute('aria-selected', o.dataset.theme === theme ? 'true' : 'false');
      });
      if (fabPanel) fabPanel.querySelectorAll('.tp-fab-opt').forEach(function (o) {
        o.classList.toggle('active', o.dataset.theme === theme);
      });
      var newState = Object.assign({}, window.__TWEAK_DEFAULTS__, { theme: theme });
      window.__TWEAK_DEFAULTS__ = newState;
      window.__applyTweaks(newState);
      try { localStorage.setItem('__tweaks__', JSON.stringify(newState)); } catch (e) {}
    }

    /* Desktop picker */
    function openPicker() {
      if (!picker || !btn || !panel) return;
      var rect = btn.getBoundingClientRect();
      panel.style.top   = (rect.bottom + 10) + 'px';
      panel.style.right = (window.innerWidth - rect.right) + 'px';
      picker.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      if (backdrop) backdrop.classList.add('show');
    }
    function closePicker() {
      if (!picker) return;
      picker.classList.remove('open');
      if (btn)      btn.setAttribute('aria-expanded', 'false');
      if (panel)    panel.setAttribute('aria-hidden', 'true');
      if (backdrop) backdrop.classList.remove('show');
    }
    if (btn) btn.addEventListener('click', function (e) {
      e.stopPropagation();
      picker.classList.contains('open') ? closePicker() : openPicker();
    });
    if (panel) panel.querySelectorAll('.tp-option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        applyTheme(opt.dataset.theme, opt.dataset.name, opt.dataset.color);
        closePicker();
      });
    });

    /* Mobile FAB */
    function openFab() {
      if (!fab) return;
      fab.classList.add('open');
      if (fabBtn)   fabBtn.setAttribute('aria-expanded', 'true');
      if (fabPanel) fabPanel.setAttribute('aria-hidden', 'false');
      if (backdrop) backdrop.classList.add('show');
    }
    function closeFab() {
      if (!fab) return;
      fab.classList.remove('open');
      if (fabBtn)   fabBtn.setAttribute('aria-expanded', 'false');
      if (fabPanel) fabPanel.setAttribute('aria-hidden', 'true');
      if (backdrop) backdrop.classList.remove('show');
    }
    if (fabBtn) fabBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      fab.classList.contains('open') ? closeFab() : openFab();
    });
    if (fabPanel) fabPanel.querySelectorAll('.tp-fab-opt').forEach(function (opt) {
      opt.addEventListener('click', function () {
        applyTheme(opt.dataset.theme, opt.dataset.name, opt.dataset.color);
        closeFab();
      });
    });

    if (backdrop) backdrop.addEventListener('click', function () { closePicker(); closeFab(); });
    document.addEventListener('click', function (e) {
      if (picker && !picker.contains(e.target)) closePicker();
      if (fab    && !fab.contains(e.target))    closeFab();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closePicker(); closeFab(); }
    });
  })();

  (function () {
    var el = document.querySelector('[data-scramble]');
    if (!el) return;
    var final = el.textContent;
    var chars = '!<>-_\\/[]{}=+*^?#____PIYUSH';
    var frame = 0, raf = null;
    function scrambleTo(target) {
      var queue = [];
      for (var i = 0; i < target.length; i++) {
        var start = Math.floor(Math.random() * 20);
        queue.push({ from: el.textContent[i] || '', to: target[i], start: start, end: start + Math.floor(Math.random() * 20) + 8, ch: '' });
      }
      frame = 0;
      cancelAnimationFrame(raf);
      function update() {
        var out = '', done = 0;
        for (var q of queue) {
          if (frame >= q.end) { out += q.to; done++; }
          else if (frame >= q.start) {
            if (!q.ch || Math.random() < 0.28) q.ch = chars[Math.floor(Math.random() * chars.length)];
            out += q.ch;
          } else out += q.from;
        }
        el.textContent = out;
        if (done < queue.length) { frame++; raf = requestAnimationFrame(update); }
      }
      update();
    }
    el.textContent = '';
    setTimeout(function () { scrambleTo(final); }, 700);
    el.addEventListener('pointerenter', function () { scrambleTo(final); });
  })();

  (function () {
    var toggle = document.getElementById('navToggle');
    var nav    = document.getElementById('mobileNav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      toggle.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', open);
      nav.setAttribute('aria-hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    });
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        nav.classList.remove('open');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        nav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  })();
</script>

<style>
  .chrome .mark {
    text-decoration: none;
  }
  .nav-active .nav-label {
    opacity: 0.5;
  }
</style>
