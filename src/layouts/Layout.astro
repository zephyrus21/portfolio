---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'Piyush Pandey — Software Engineer · Go & Distributed Systems',
  description = 'Piyush Pandey — backend software engineer (SDE) building event-driven systems and Go microservices at scale. Distributed systems, ad-tech & startup backends, observability. Available for contract, freelance, and full-time work.',
  ogImage = '/og.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Piyush Pandey',
  url: 'https://www.piyushify.com',
  image: ogImageUrl,
  jobTitle: 'Software Engineer',
  email: 'mailto:pandey.piyus@gmail.com',
  description:
    'Backend software engineer building event-driven systems and Go microservices at scale — distributed systems, ad-tech and startup backends, observability.',
  knowsAbout: [
    'Software Engineering',
    'Backend Development',
    'Go (Golang)',
    'Microservices',
    'Distributed Systems',
    'Event-Driven Architecture',
    'Event Pipelines',
    'Ad Tech',
    'Observability',
    'Startups',
    'Cloud Infrastructure',
  ],
  sameAs: [
    'https://github.com/zephyrus21',
    'https://linkedin.com/in/zephyrus21',
  ],
  seeks: {
    '@type': 'Demand',
    name: 'Software engineering contract, freelance, and full-time opportunities',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Piyush Pandey" />
    <meta name="theme-color" content="#14110d" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Open Graph (LinkedIn, Slack, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Piyush Pandey" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="icon" type="image/svg+xml" id="site-favicon" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <!-- Apply theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        var saved;
        try { saved = JSON.parse(localStorage.getItem('__tweaks__') || 'null'); } catch (e) {}
        var d = Object.assign(
          { theme: 'warm', heroMotion: 'weight', customCursor: true, density: 'airy', typePair: 'all-mono' },
          saved || {}
        );
        window.__TWEAK_DEFAULTS__ = d;
        var ALL_THEMES = ['theme-warm','theme-dark','theme-cool','theme-mono',
          'theme-catppuccin','theme-nord','theme-gruvbox','theme-rose-pine',
          'theme-latte','theme-parchment','theme-forest','theme-lavender',
          'theme-dracula','theme-monokai','theme-tokyo','theme-solarized'];
        function applyTweaks(t) {
          var b = document.documentElement;
          ALL_THEMES.forEach(function(c){ b.classList.remove(c); });
          b.classList.add('theme-' + (t.theme || 'warm'));
        }
        applyTweaks(d);
      })();
    </script>
  </head>

  <body>
    <div class="corner tl"></div>
    <div class="corner tr"></div>
    <div class="corner bl"></div>
    <div class="corner br"></div>

    <div class="cursor" id="cursor"></div>
    <div class="scroll-progress" id="scrollProgress"></div>

    <slot />

    <script is:inline>
      /* Tweak defaults & applyTweaks (full version) */
      (function () {
        var saved; try { saved = JSON.parse(localStorage.getItem('__tweaks__') || 'null'); } catch (e) {}
        window.__TWEAK_DEFAULTS__ = Object.assign(
          { theme: 'warm', heroMotion: 'weight', customCursor: true, density: 'airy', typePair: 'all-mono' },
          saved || {}
        );
      })();

      var ALL_THEMES = ['theme-warm','theme-dark','theme-mono','theme-cool',
        'theme-catppuccin','theme-latte','theme-nord','theme-gruvbox','theme-rose-pine',
        'theme-parchment','theme-forest','theme-lavender',
        'theme-dracula','theme-monokai','theme-tokyo','theme-solarized'];

      function applyTweaks(t) {
        var body = document.body;
        var theme = t.theme || 'warm';
        ALL_THEMES.forEach(function(c){ body.classList.remove(c); });
        body.classList.add('theme-' + theme);
        body.classList.toggle('no-custom-cursor', !t.customCursor);
        /* sync picker trigger + active option */
        var THEME_META = {
          'warm': { name: 'Warm', color: '#f3efe7' },
          'dark': { name: 'Ink', color: '#0d0c0b' },
          'cool': { name: 'Cool', color: '#eef0f2' },
          'catppuccin': { name: 'Catppuccin', color: '#1e1e2e' },
          'nord': { name: 'Nord', color: '#2e3440' },
          'gruvbox': { name: 'Gruvbox', color: '#282828' },
          'rose-pine': { name: 'Rosé Pine', color: '#191724' },
          'latte': { name: 'Latte', color: '#eff1f5' },
          'parchment': { name: 'Parchment', color: '#f5f0e8' },
          'forest': { name: 'Forest', color: '#f0f4ee' },
          'lavender': { name: 'Lavender', color: '#f4f0fa' },
          'dracula': { name: 'Dracula', color: '#282a36' },
          'monokai': { name: 'Monokai', color: '#272822' },
          'tokyo': { name: 'Tokyo Night', color: '#1a1b26' },
          'solarized': { name: 'Solarized', color: '#002b36' }
        };
        var meta = THEME_META[theme] || THEME_META['warm'];
        var dotEl = document.getElementById('tpActiveDot');
        var nameEl = document.getElementById('tpActiveName');
        if (dotEl) dotEl.style.setProperty('--tw', meta.color);
        if (nameEl) nameEl.textContent = meta.name;
        document.querySelectorAll('.tp-option').forEach(function(o) {
          o.classList.toggle('active', o.dataset.theme === theme);
          o.setAttribute('aria-selected', o.dataset.theme === theme ? 'true' : 'false');
        });
        document.documentElement.style.setProperty('--pad-y',
          t.density === 'tight' ? 'clamp(32px,6vh,72px)' :
          t.density === 'airy'  ? 'clamp(72px,14vh,180px)' :
                                   'clamp(48px,10vh,120px)'
        );
        var r = document.documentElement.style;
        if (t.typePair === 'serif-sans') {
          r.setProperty('--serif', '"Instrument Serif", "Newsreader", Georgia, serif');
          r.setProperty('--sans',  '"Geist", ui-sans-serif, system-ui, sans-serif');
        } else if (t.typePair === 'serif-mono') {
          r.setProperty('--serif', '"Newsreader", "Instrument Serif", Georgia, serif');
          r.setProperty('--sans',  '"JetBrains Mono", ui-monospace, monospace');
        } else if (t.typePair === 'all-serif') {
          r.setProperty('--serif', '"Instrument Serif", Georgia, serif');
          r.setProperty('--sans',  '"Newsreader", Georgia, serif');
        } else if (t.typePair === 'all-mono') {
          r.setProperty('--serif', '"JetBrains Mono", ui-monospace, monospace');
          r.setProperty('--sans',  '"JetBrains Mono", ui-monospace, monospace');
        }
        window.__heroMotion = t.heroMotion;
        updateFavicon();
      }

      function updateFavicon() {
        requestAnimationFrame(function () {
          var s    = getComputedStyle(document.body);
          var rs   = getComputedStyle(document.documentElement);
          var bg   = s.getPropertyValue('--bg').trim();
          var ink  = s.getPropertyValue('--ink').trim();
          var font = (rs.getPropertyValue('--serif').trim() || 'serif').replace(/"/g, "'");
          if (!bg || !ink) return;
          var svg =
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
            '<rect width="32" height="32" rx="5" fill="' + ink + '"/>' +
            '<text x="16" y="24" text-anchor="middle"' +
            ' font-family="' + font + '"' +
            ' font-size="22" font-weight="400"' +
            ' fill="' + bg + '">P</text>' +
            '</svg>';
          var link = document.getElementById('site-favicon');
          if (link) link.href = 'data:image/svg+xml,' + encodeURIComponent(svg);
        });
      }

      applyTweaks(window.__TWEAK_DEFAULTS__);
      window.__applyTweaks = applyTweaks;

      /* After the chromeIn animation completes, remove the animation so its
         fill value (identity matrix) doesn't persist as a transform on
         .chrome-right. Chromium treats any animation-derived transform —
         even transform:none — as matrix(1,0,0,1,0,0), which creates a
         stacking context and breaks position:fixed children (theme-picker
         panel) that should be positioned relative to the viewport. */
      (function () {
        document.querySelectorAll('.chrome > *').forEach(function (el) {
          el.addEventListener('animationend', function handler() {
            this.style.animation = 'none';
            this.style.opacity = '1';
            this.removeEventListener('animationend', handler);
          });
        });
      })();

      /* Custom cursor */
      (function () {
        if (window.matchMedia('(pointer: coarse)').matches) return;
        var c = document.getElementById('cursor');
        var x = 0, y = 0, tx = 0, ty = 0, rafId = null;
        function loop() {
          rafId = null;
          x += (tx - x) * 0.22; y += (ty - y) * 0.22;
          c.style.transform = 'translate(' + x + 'px, ' + y + 'px) translate(-50%, -50%)';
          if (Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5) {
            rafId = requestAnimationFrame(loop);
          }
        }
        window.addEventListener('pointermove', function (e) {
          tx = e.clientX; ty = e.clientY;
          if (!rafId) rafId = requestAnimationFrame(loop);
        });
        document.querySelectorAll('a, button, .work-row, [data-cursor="ring"]').forEach(function (el) {
          el.addEventListener('pointerenter', function () { c.classList.add('ring'); });
          el.addEventListener('pointerleave', function () { c.classList.remove('ring'); });
        });
      })();

      /* Magnetic hover */
      (function () {
        document.querySelectorAll('[data-magnetic]').forEach(function (el) {
          el.style.transition = 'transform 500ms cubic-bezier(.2,.7,.2,1)';
          el.addEventListener('pointermove', function (e) {
            var r = el.getBoundingClientRect();
            var dx = e.clientX - (r.left + r.width / 2);
            var dy = e.clientY - (r.top + r.height / 2);
            el.style.transform = 'translate(' + (dx * 0.18) + 'px, ' + (dy * 0.28) + 'px)';
          });
          el.addEventListener('pointerleave', function () { el.style.transform = ''; });
        });
      })();

      /* Scroll reveal */
      (function () {
        document.querySelectorAll('.reveal-line').forEach(function (el, i) {
          el.style.setProperty('--rd', (i * 80) + 'ms');
        });
        document.querySelectorAll('.about-facts li').forEach(function (el, i) {
          el.style.setProperty('--fd', (i * 90) + 'ms');
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('.reveal, .reveal-line, .exp-row, .writing-row, .about-facts')
          .forEach(function (el) { io.observe(el); });
      })();

      /* Scroll progress */
      (function () {
        var bar = document.getElementById('scrollProgress');
        function update() {
          var doc = document.documentElement;
          var max = doc.scrollHeight - window.innerHeight;
          var p = max > 0 ? (window.scrollY / max) * 100 : 0;
          bar.style.setProperty('--p', p + '%');
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      /* Smooth scroll with custom easing */
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        function easeInOutQuart(t) {
          return t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;
        }
        function smoothScrollTo(target, duration) {
          var start = window.scrollY;
          var end = target;
          var startTime = null;
          function step(ts) {
            if (!startTime) startTime = ts;
            var elapsed = ts - startTime;
            var progress = Math.min(elapsed / duration, 1);
            window.scrollTo(0, start + (end - start) * easeInOutQuart(progress));
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a[href^="#"]');
          if (!a) return;
          var id = a.getAttribute('href').slice(1);
          var el = document.getElementById(id);
          if (!el) return;
          e.preventDefault();
          var top = el.getBoundingClientRect().top + window.scrollY;
          smoothScrollTo(top, 900);
        });
      })();

      /* Tweak message listener */
      window.addEventListener('message', function (e) {
        var d = e.data || {};
        if (d.type === '__edit_mode_state' && d.state) applyTweaks(d.state);
      });
    </script>
  </body>
</html>
