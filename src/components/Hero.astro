<section class="hero" id="top">
  <div class="hero-label eyebrow reveal">
    <span class="num">00</span><span class="bar"></span><span>Portfolio · MMXXVI</span>
  </div>

  <div class="lockup">
    <h1 class="hero-name" id="heroName" aria-label="Piyush Pandey">
      <span class="word" data-word="Piyush">Piyush</span>
      <span class="word" data-word="Pandey">Pandey</span>
      <span class="word" data-word="Software Engineer">Software Engineer</span>
    </h1>

    <div class="hero-meta">
      <div class="role reveal-line">
        <span>Software Engineer — building event pipelines &amp; quiet backends.</span>
      </div>
      <div class="blurb reveal-line">
        <span>Currently at <em>Mable.ai</em>, shipping Go microservices that move 100M+
          events a day. I like distributed systems, observability, and writing code the next engineer can read.</span>
      </div>
    </div>
  </div>

  <div class="hero-bottom">
    <span class="cursor-hint"></span>
    <span class="scroll-cue">Scroll <span class="line"></span></span>
  </div>
</section>

<script is:inline>
  (function heroMotion() {
    var root = document.getElementById('heroName');
    var words = root.querySelectorAll('.word');
    var glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';

    /* Build char spans, start each as a random glyph */
    var allChars = [];
    words.forEach(function (w) {
      var txt = w.dataset.word;
      w.innerHTML = '';
      for (var i = 0; i < txt.length; i++) {
        var s = document.createElement('span');
        s.className = 'char scrambling';
        s.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
        w.appendChild(s);
        allChars.push({ el: s, final: txt[i] });
      }
    });

    /* Stagger-resolve: each char scrambles briefly then snaps to its final letter */
    allChars.forEach(function (item, idx) {
      var resolveAt = 180 + idx * 58;
      setTimeout(function () {
        var count = 0;
        var cycles = 5 + Math.floor(Math.random() * 4);
        var timer = setInterval(function () {
          if (count >= cycles) {
            item.el.textContent = item.final;
            item.el.classList.remove('scrambling');
            item.el.classList.add('resolved');
            clearInterval(timer);
          } else {
            item.el.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
            count++;
          }
        }, 38);
      }, resolveAt);
    });

    /* Hover: re-scramble a single char briefly when cursor passes over it */
    root.addEventListener('pointerover', function (e) {
      var c = e.target.closest && e.target.closest('.char.resolved');
      if (!c) return;
      var finalChar = c.textContent;
      c.classList.replace('resolved', 'scrambling');
      var count = 0;
      var timer = setInterval(function () {
        if (count >= 5) {
          c.textContent = finalChar;
          c.classList.replace('scrambling', 'resolved');
          clearInterval(timer);
        } else {
          c.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
          count++;
        }
      }, 35);
    });

  })();
</script>
