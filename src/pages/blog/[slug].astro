---
import Layout from '../../layouts/Layout.astro';
import PageChrome from '../../components/PageChrome.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, getPostBySlug } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
if (!post) return Astro.redirect('/blog');
---

<Layout title={`${post.title} — Piyush Pandey`}>
  <PageChrome active="blog" />

  <main class="page-main">
    <article class="post">
      <header class="post-header">
        <div class="post-meta reveal">
          <a href="/blog" class="back-link">
            <span class="back-arrow">←</span> Blog
          </a>
          <span class="post-divider">·</span>
          <span class="post-tag">{post.tag}</span>
          <span class="post-divider">·</span>
          <span class="post-year">{post.year}</span>
          <span class="post-divider">·</span>
          <span class="post-read">{post.readTime}</span>
        </div>

        <h1 class="post-title reveal">{post.title}</h1>
        {post.subtitle && <p class="post-subtitle reveal">{post.subtitle}</p>}
      </header>

      <div class="post-rule reveal"></div>

      <div class="post-body reveal" set:html={post.contentHtml} />

      <footer class="post-footer reveal">
        <a href="/blog" class="back-link">
          <span class="back-arrow">←</span> Back to blog
        </a>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .page-main {
    padding-top: 80px;
  }

  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--pad-y) var(--gutter);
  }

  .post-header {
    margin-bottom: 56px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 300ms ease;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .back-arrow {
    display: inline-block;
    transition: transform 300ms cubic-bezier(.2, .7, .2, 1);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  .post-divider {
    opacity: 0.3;
  }

  .post-tag,
  .post-year,
  .post-read {
    color: var(--ink-soft);
  }

  .post-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 28px;
    color: var(--ink);
  }

  .post-subtitle {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
  }

  .post-rule {
    height: 1px;
    background: var(--rule);
    margin: 56px 0;
  }

  .post-body {
    font-family: var(--serif);
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.65;
    color: var(--ink);
  }

  .post-body :global(p) {
    margin: 0 0 1.6em;
  }

  .post-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .post-body :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 2.4em 0 0.8em;
    color: var(--ink);
  }

  .post-body :global(h3) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.3;
    margin: 2em 0 0.6em;
    color: var(--ink);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.5em;
    margin: 0 0 1.6em;
  }

  .post-body :global(li) {
    margin-bottom: 0.4em;
  }

  .post-body :global(blockquote) {
    border-left: 2px solid var(--rule);
    padding-left: 1.2em;
    margin: 2em 0;
    color: var(--ink-soft);
    font-style: italic;
  }

  .post-body :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--rule);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .post-body :global(pre) {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--rule);
    padding: 1.2em 1.4em;
    border-radius: 6px;
    overflow-x: auto;
    margin: 0 0 1.6em;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-footer {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }

  .post-footer .back-link {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
