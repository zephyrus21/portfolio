---
import Layout from '../layouts/Layout.astro';
import PageChrome from '../components/PageChrome.astro';
import Footer from '../components/Footer.astro';
import { getPublishedPosts } from '../lib/notion';

const posts = await getPublishedPosts();
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');
---

<Layout title="Writing — Piyush Pandey">
  <PageChrome active="blog" />

  <main class="page-main">
    <section class="page-hero">
      <div class="eyebrow reveal"><span class="num">01</span><span class="bar"></span><span>Writing</span></div>
      <h1 class="h-display reveal" style="margin-top: 28px;">
        Notes from the <em>margins</em>.
      </h1>
      <p class="page-hero-sub reveal">
        Essays, notes, and field guides on building software at scale.
      </p>
    </section>

    <section class="writing-page-section">
      <div class="writing-list">
        {posts.map((post) => (
          <a class="writing-row reveal" href={`/blog/${post.slug}`}>
            <span class="date">{post.year}</span>
            <span class="title">{post.title}</span>
            <span class="tag">{post.tag}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-main {
    padding-top: 80px;
  }

  .page-hero {
    padding: var(--pad-y) var(--gutter);
    border-top: 0;
    max-width: 900px;
  }

  .page-hero-sub {
    margin-top: 28px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .writing-page-section {
    padding: 0 var(--gutter) var(--pad-y);
    border-top: 1px solid var(--rule);
  }

  .writing-list {
    margin-top: 0;
    display: flex;
    flex-direction: column;
  }
</style>
